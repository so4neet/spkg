#!/bin/env bash

VERSION=$(git rev-parse --short HEAD)
DEBUG=1
cTarget="spkg.out"
cObjs=$(find src -type f -name "*.c")
cFlags="-std=c99"

while getopts r flag
do
    case "${flag}" in
	r) DEBUG=0;;
    esac
done
echo "#define VERSION ${VERSION}" > src/version.h 

if [ "$DEBUG" -eq 1 ]; then
    echo "Building with debug flags"
    clang $cObjs $cFlags -o bin/$cTarget -DDEBUG
else
    echo "Building release"
    clang $cObjs $cFlags -o bin/$cTarget
fi
