#!/bin/env bash

# Versioning Stuff
VERSION=$(git rev-parse --short HEAD)
GIT_STAT=$(git diff --quiet || echo '::dirty')
DEBUG=1
cTarget="spkg.out"
cObjs=$(find src -type f -name "*.c")
cFlags="-std=c99"

while getopts r flag
do
    case "${flag}" in
	r) DEBUG=0;;
    esac
done
echo "#define VERSION \"${VERSION}${GIT_STAT}\"" > src/version.h 

if [ "$DEBUG" -eq 1 ]; then
    echo "Building with debug flags"
    clang $cObjs $cFlags -o bin/$cTarget -DDEBUG -D_GNU_SOURCE
else
    echo "Building release"
    clang $cObjs $cFlags -o bin/$cTarget -D_GNU_SOURCE
fi
